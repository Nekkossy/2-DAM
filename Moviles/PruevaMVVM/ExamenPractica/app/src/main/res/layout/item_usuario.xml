<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txtIniciales"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="@string/ab"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Apellidos"
            android:textColor="#202238"
            android:textStyle="bold"
            android:textSize="17sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_1_dam_18_a_os"
            android:textColor="#74758C"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/correo_ejemplo_es2"
            android:textColor="#74758C"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="Activo"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="›"
        android:textColor="#66677C"
        android:textSize="30sp"
        android:gravity="center" />
</LinearLayout>
